{
  "name": "m2api-client",
  "version": "0.1.0",
  "description": "A premium API testing workspace for React: request builder, response inspector, auth, environments, collections, history and cURL import/export, plus a typed, UI-independent request engine and hooks.",
  "keywords": [
    "react",
    "api",
    "api-client",
    "api-testing",
    "http",
    "rest",
    "fetch",
    "postman",
    "swagger",
    "openapi",
    "curl",
    "request-builder",
    "devtools",
    "hooks",
    "typescript"
  ],
  "author": "Mohsin Zia <mohsinziadev@gmail.com>",
  "license": "MIT",
  "homepage": "https://www.m2toolkit.com/npm-packages/m2api-client",
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./styles.css": "./dist/styles.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "dev": "vite --config demo/vite.config.ts",
    "build": "node scripts/build.mjs && node scripts/build-css.mjs",
    "build:demo": "vite build --config demo/vite.config.ts",
    "build:demo:dist": "M2API_DEMO_DIST=1 vite build --config demo/vite.config.ts",
    "preview:demo": "vite preview --config demo/vite.config.ts",
    "build:site": "node scripts/build-site.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p demo/tsconfig.json --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/size.mjs",
    "check:package": "publint --strict && attw --pack . --profile node16 --exclude-entrypoints ./styles.css",
    "smoke": "node scripts/smoke-test.mjs",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run test && npm run build && npm run check:package && npm run size && npm run smoke",
    "prepublishOnly": "npm run verify"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "jsdom": "^30.1.3",
    "lightningcss": "^1.33.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rolldown": "^1.2.14",
    "rolldown-plugin-dts": "^0.28.8",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.5"
  }
}
